<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass: translucent fill, light from the top, thin bright edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="270" android:startColor="@color/byte_widget_glass_top" android:endColor="@color/byte_widget_glass_bottom" />
            <stroke android:width="1dp" android:color="@color/byte_widget_edge" />
        </shape>
    </item>
</layer-list>
